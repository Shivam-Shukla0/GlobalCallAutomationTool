# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///call_automation.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Twilio Configuration
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# Google Sheets Configuration
# ============================================
# Paste your service account JSON credentials here
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"your_project_id",...}

# ============================================
# Redis Configuration (Optional)
# For distributed rate limiting and caching
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Flask Configuration
# ============================================
SESSION_SECRET=your_secret_key_change_this_in_production
FLASK_ENV=production
FLASK_DEBUG=False

# ============================================
# Performance Settings
# ============================================
# Cache TTL for queue statistics (seconds)
STATS_CACHE_TTL=5

# Exponential backoff max delay for empty queue polling (seconds)
EMPTY_QUEUE_MAX_DELAY=30
